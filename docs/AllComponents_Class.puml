    class ControllerAggregate {}
    struct AudioVisualizerConfig {}
    struct Event {}
    rectangle Handlers {
        class InitHandler {}
        class RuntimeHandler {}
        class ErrorHandler {}
    }
}

rectangle AudioProcessor {
    class AudioProcessorAggregate {}
    class AudioSource {}
    struct Audio {}
    class AudioTransform {}
}

rectangle Visualizer {
